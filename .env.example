# Copy to .env and fill in. Used both by `uv run python app.py` (via python-dotenv)
# and by `docker compose` (env_file + ${...} interpolation).

# --- Database (external PostgreSQL, e.g. on the NAS) ---
# DB_URL holds driver/host/port/database only; user + password are injected separately.
DB_URL=postgresql://192.168.2.230:5432/footage_archive
DB_USER=footage_archive_app                 # app role: SELECT/INSERT/UPDATE/DELETE
DB_PASSWORD=
DB_OWNER_USER=footage_archive_owner         # owner role: used by Alembic for DDL
DB_OWNER_PASSWORD=

# --- Media library ---
# ROOT_DIR is the scan root *inside the backend container* and is forced to
# /footage by docker-compose.yml. For local (non-Docker) runs set it to a path.
ROOT_DIR=./footage
MEDIA_TYPE_VIDEO=.mov,.mp4
MEDIA_TYPE_PHOTO=.jpg,.jpeg,.rw2,.dng
MEDIA_TYPE_360_VIDEO=.insv
MEDIA_TYPE_360_PHOTO=.insp
BROWSER_HIDDEN_EXTENSIONS=.xmp,.acr,.psd,.lrv,.identifier,.list
# Exact (case-insensitive) file names hidden from the browser (#81) — OS junk
# with no distinguishing extension (BROWSER_HIDDEN_EXTENSIONS can't match
# .DS_Store, which has none).
BROWSER_HIDDEN_NAMES=.DS_Store,Thumbs.db,desktop.ini
TASK_POLL_INTERVAL_MS=5000
# Single folder name (no '/', not '.'/'..') for the trash directory, created
# directly under ROOT_DIR. Delete-to-trash (fileops/trash.py) moves files/
# folders here instead of removing them; it's hidden from browsing, scanning
# and move/rename targets. Invalid values fail fast at startup.
TRASH_DIR_NAME=.trash

# --- Google Maps (frontend map rendering + geocoding) ---
# See GOOGLE_SETUP.md for how to obtain these. The key is exposed to the browser
# via /config (restrict it by HTTP referrer + API in the Cloud console). The Map ID
# is required for Advanced Markers. Leave both blank to disable the maps.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
# Optional second Map ID (#107) whose style shows points of interest
# (sights/parks/transit) — lets the frontend's Settings/Map-page "Places"
# toggle switch POIs on. Leave blank to hide that toggle.
GOOGLE_MAPS_MAP_ID_POI=
# Size of the shared worker pool that parallelises hashing + probing within scans
# (one pool across all background jobs, so total concurrency stays bounded).
WORKER_POOL_SIZE=4
# Number of candidates a directory scan hashes + reconciles per batch (#135)
# instead of over the whole tree at once — smaller means results land in the
# DB (and show in the browser) sooner, at the cost of more round-trips for a
# large directory.
SCAN_BATCH_SIZE=25
# SQLAlchemy connection pool. Max concurrent DB connections = DB_POOL_SIZE +
# DB_MAX_OVERFLOW; keep this >= expected peak worker threads doing DB writes.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Load management (#71) — scanning videos is CPU-heavy (ffmpeg decodes
# with one thread per core by default); these keep the host from overheating
# under concurrent scans. All read-only on the Settings page for now. ---
# Decoding threads per ffmpeg/ffprobe invocation.
FFMPEG_THREADS=2
# Global ceiling on concurrent CPU-heavy jobs (clip previews, raw photo
# decoding, …), independent of WORKER_POOL_SIZE.
HEAVY_JOB_CONCURRENCY=2
# os.nice() delta applied to ffmpeg/ffprobe/exiftool child processes.
PROCESS_NICENESS=10
# Heavy jobs pause while the CPU is at/above this temperature (°C). 0 disables
# the check (e.g. no readable sensor in this environment).
CPU_TEMP_LIMIT_C=85
# Heavy jobs pause while the 1-minute load average is at/above this value.
# 0 disables the check. Defaults to the host's CPU core count when unset.
# LOAD_AVG_LIMIT=16

# --- Docker compose only ---
# Host path mounted to /footage in the backend container (Unraid: /mnt/user/footage)
FOOTAGE_DIR=./footage
# Host port the frontend (nginx) is published on -> http://<host>:8080
FRONTEND_PORT=8080
